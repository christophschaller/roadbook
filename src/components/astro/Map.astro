---
import MapView from "@/components/react/MapView/MapView";

interface Props {
  routeSlug: string;
}

const { routeSlug } = Astro.props;
---

<div id="map-container" class="h-full">
  <MapView client:only routeSlug={routeSlug} />
</div>

<style>
  #map-container {
    height: 100vh;
    width: 100vw;
  }
</style>

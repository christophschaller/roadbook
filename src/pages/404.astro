---
import Layout from "@/layouts/Layout.astro";

const base = import.meta.env.BASE_URL;
---

<Layout>
	<main class="not-found">
		<h1>Page not found</h1>
		<p><a href={`${base}routes/`}>Browse routes</a></p>
	</main>
</Layout>

<style>
	.not-found {
		max-width: 40rem;
		margin: 4rem auto;
		padding: 0 1.5rem;
		font-family: system-ui, sans-serif;
		text-align: center;
	}
</style>

---
import "@/styles/globals.css";
import Layout from "@/layouts/Layout.astro";
import routesIndex from "../../../public/data/routes-index.json";

const base = import.meta.env.BASE_URL;
---

<Layout>
	<main class="routes-index">
		<h1>Routes</h1>
		<ul>
			{
				routesIndex.routes.map((route) => (
					<li>
						<a href={`${base}routes/${route.slug}/`}>{route.displayName}</a>
					</li>
				))
			}
		</ul>
		<p>
			<a href={`${base}playground/`}>Upload your own GPX</a>
		</p>
	</main>
</Layout>

<style>
	.routes-index {
		max-width: 40rem;
		margin: 2rem auto;
		padding: 0 1.5rem;
		font-family: system-ui, sans-serif;
	}

	.routes-index h1 {
		margin-bottom: 1rem;
	}

	.routes-index ul {
		list-style: none;
		padding: 0;
		margin: 0 0 1.5rem;
	}

	.routes-index li + li {
		margin-top: 0.5rem;
	}

	.routes-index a {
		color: #2563eb;
		text-decoration: none;
	}

	.routes-index a:hover {
		text-decoration: underline;
	}
</style>

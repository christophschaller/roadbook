---
interface Props {
  title?: string;
}

const { title = "Roadbook" } = Astro.props;
const base = import.meta.env.BASE_URL;
const faviconHref = base.endsWith("/")
  ? `${base}favicon.svg`
  : `${base}/favicon.svg`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={faviconHref} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>

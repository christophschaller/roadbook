{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["routes"],
  "properties": {
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["displayName", "folder"],
        "additionalProperties": false,
        "properties": {
          "displayName": { "type": "string", "minLength": 1 },
          "folder": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Directory name under routes/, not used in URLs"
          },
          "bufferMeters": {
            "type": "number",
            "minimum": 100,
            "maximum": 25000,
            "description": "Overpass POI search buffer around the route in meters (default: 2500)"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
